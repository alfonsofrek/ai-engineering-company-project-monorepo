# Copy to .env (never commit .env) and fill in real values.
#   cp .env.example .env

# --- API (FastAPI) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origin allowed by CORS (the backoffice as seen from the browser).
BACKOFFICE_ORIGIN=http://localhost:3001

# --- Published ports on the host ---
API_PORT=8000
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
