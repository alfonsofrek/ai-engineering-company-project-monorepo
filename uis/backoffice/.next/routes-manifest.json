        "source": "/api/suppliers",
        "destination": "http://127.0.0.1:8000/suppliers",
        "regex": "^/api/suppliers(?:/)?$"
      },
      {
        "source": "/api/suppliers/:path*",
        "destination": "http://127.0.0.1:8000/suppliers/:path*",
        "regex": "^/api/suppliers(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/api/incidents",
