      },
      {
        "source": "/api/users/:path*",
        "destination": "http://127.0.0.1:8000/users/:path*",
        "regex": "^/api/users(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/api/profiles/:path*",
