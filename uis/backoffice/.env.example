# Copy to .env.local (ignored by git).
# Telemetry endpoint. Default: same-origin proxy /api/telemetry/events → API /telemetry/events.
# You can also point it straight at the API, e.g. http://localhost:8000/telemetry/events
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/api/telemetry/events
# Release tag sent in source.release (e.g. the short git SHA in CI).
NEXT_PUBLIC_RELEASE=dev
# Where the Next.js proxy forwards /api/* (server side).
API_INTERNAL_URL=http://127.0.0.1:8000
