JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Telemetry ingestion endpoint (Phase 2: stub that validates and logs; Phase 3: persists to Supabase)
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
# Origins allowed to call the API directly (comma-separated). Defaults to BACKOFFICE_ORIGIN.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Development only: log every received event in full to check formats and that no PII is sent.
TELEMETRY_LOG_PAYLOAD=false
