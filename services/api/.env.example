JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password reset email (Resend: https://resend.com → API Keys)
RESEND_API_KEY=re_replace_with_your_resend_api_key
# Optional. Resend's onboarding sender works without a custom domain.
EMAIL_FROM=TrackFlow <onboarding@resend.dev>
# Optional. Link sent in the email; defaults to BACKOFFICE_ORIGIN + /reset-password.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# Optional. Reset link lifetime (15-60 minutes).
PASSWORD_RESET_TOKEN_MINUTES=30
